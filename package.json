{
  "name": "domain-driven-desing",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.16.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@formula-monks/renderizr": "github:FormulaMonks/renderizr#v2.5.0",
    "husky": "^9.1.7"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "pnpm lint:ts && pnpm lint:py",
    "lint:ts": "biome check && pnpm -r --if-present typecheck",
    "lint:py": "uv run ruff check && uv run ruff format --check"
  }
}
